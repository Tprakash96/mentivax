# Copy to .env at the repo root and adjust.

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://mentivax:mentivax@localhost:5544/mentivax?schema=public"

# API
PORT=4000

# Web dev-server port. Leave unset to use Vite's default (5173, drifting upward
# if taken). Set it to pin the port when something else on the machine owns 5173
# — `pnpm dev` then fails loudly on a clash instead of moving silently.
# WEB_PORT=5273

# Auth. JWT_SECRET signs access tokens — the API refuses to boot in production
# while it is unset or still the placeholder below. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-change-me"
# Access-token lifetime (s/m/h/d). Short by design; the refresh token carries
# the session and is rotated on every use.
JWT_ACCESS_TTL="15m"
# How long a signed-in session survives without re-entering a password.
JWT_REFRESH_TTL_DAYS=30

# Web / clients — where the API is reachable
VITE_API_URL="http://localhost:4000"

# --- File storage (S3) for student documents ---
# All four are needed together; with any of them missing, document upload stays
# off and the rest of the app runs normally.
# Folder structure: {admissionYear}/{admissionNo}/{file}
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_ACCESS_KEY / AWS_SECRET_KEY are accepted as aliases for the two above.
S3_BUCKET=
# Optional, for S3-compatible stores (MinIO / DigitalOcean Spaces / Cloudflare R2):
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# --- Ask: the read-only, RLS-enforced connection for AI-written SQL ---
# Ask lets the model write SELECT statements. They run as `mentivax_ask`, a role
# created by the `ask_row_level_security` migration that holds SELECT and nothing
# else, and whose every read is filtered by a row-level policy on the caller's
# organization. Leave this unset and Ask falls back to its own question reader.
#
# The migration cannot set a password (it would end up in git), so do it once per
# environment and put the result here:
#   ALTER ROLE mentivax_ask WITH LOGIN PASSWORD '<generate one>';
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ASK_DATABASE_URL=

# --- Reports → Ask (Gemini) ---
# Powers the Ask bar on the home page. With a key, the model writes SQL against
# the schema (see ASK_DATABASE_URL above — row-level security, not the prompt, is
# what confines it to the caller's school). Without one, Ask falls back to reading
# the question itself against a narrower catalog.
GEMINI_AI_KEY=
# Optional. Ask tries a chain of models and moves to the next when one is rate
# limited, because the free tier is metered PER MODEL in tens of requests a day —
# several models is several buckets. The built-in chain is non-thinking lite
# models (writing a SELECT needs no deliberation, and they answer in ~1s where a
# thinking model takes 10-15s), verified against a real key.
#
# Override only if your account differs:
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
#
# Or pin one model to be tried first, with the chain still behind it:
# GEMINI_MODEL=gemini-3.5-flash-lite
#
# A 429 is not a bug: once every model is limited, Ask falls back to its own
# question reader and says nothing to the user about keys or quotas.
