# Copy to .env at the repo root and adjust.

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://mentivax:mentivax@localhost:5544/mentivax?schema=public"

# API
PORT=4000

# Auth. JWT_SECRET signs access tokens — the API refuses to boot in production
# while it is unset or still the placeholder below. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-change-me"
# Access-token lifetime (s/m/h/d). Short by design; the refresh token carries
# the session and is rotated on every use.
JWT_ACCESS_TTL="15m"
# How long a signed-in session survives without re-entering a password.
JWT_REFRESH_TTL_DAYS=30

# Web / clients — where the API is reachable
VITE_API_URL="http://localhost:4000"
