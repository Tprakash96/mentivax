# Copy to .env at the repo root and adjust.

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://mentivax:mentivax@localhost:5544/mentivax?schema=public"

# API
PORT=4000

# Auth. JWT_SECRET signs access tokens — the API refuses to boot in production
# while it is unset or still the placeholder below. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-change-me"
# Access-token lifetime (s/m/h/d). Short by design; the refresh token carries
# the session and is rotated on every use.
JWT_ACCESS_TTL="15m"
# How long a signed-in session survives without re-entering a password.
JWT_REFRESH_TTL_DAYS=30

# Web / clients — where the API is reachable
VITE_API_URL="http://localhost:4000"

# --- File storage (S3) for student documents ---
# Fill these to enable document uploads. Folder structure: {admissionYear}/{admissionNo}/{file}
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional, for S3-compatible stores (MinIO / DigitalOcean Spaces / Cloudflare R2):
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
